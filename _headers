# Global headers for all pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)

# Security headers for HTML pages
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://maps.google.com; frame-ancestors 'self';
  X-Robots-Tag: index, follow, max-image-preview:large
  Cache-Control: public, max-age=0, must-revalidate

# Root path (/) is not matched by the /*.html glob — duplicate the trio so the
# directory-index homepage response carries the same headers. Per Cloudflare
# Pages docs, path globbing matches the request path verbatim.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://maps.google.com; frame-ancestors 'self';
  X-Robots-Tag: index, follow, max-image-preview:large
  Cache-Control: public, max-age=0, must-revalidate

# Hindi directory index (/hi/) — same situation as /: the /*.html glob does not
# match the directory path. Duplicate the trio for the Hindi home response.
/hi/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://maps.google.com; frame-ancestors 'self';
  X-Robots-Tag: index, follow, max-image-preview:large
  Cache-Control: public, max-age=0, must-revalidate

# Cache control for assets
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable

/banner-manager.js
  Cache-Control: public, max-age=31536000, immutable

/animations.js
  Cache-Control: public, max-age=31536000, immutable

# i18n.js was missing from the JS cache rules above; versioned via ?v= like the
# other JS files, so it gets the same immutable treatment.
/i18n.js
  Cache-Control: public, max-age=31536000, immutable

# AVIF sources (e.g. /images/*.avif) had no cache rule — the /*.jpg / /*.webp
# globs don't cover them. Matches the existing image-block style.
/*.avif
  Cache-Control: public, max-age=31536000, immutable

/banners.json
  Cache-Control: public, max-age=3600

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.JPG
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
